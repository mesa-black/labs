# Géré par Ansible — toute modification à la main sera écrasée.
{% if site_domain %}
{{ site_domain }}, www.{{ site_domain }} {
	{% if site_domain %}redir https://{{ site_domain }}{uri} 301
	{% endif %}
}

{{ site_domain }} {
{% else %}
# Pas de domaine arrêté : on sert en HTTP, sur l'IP. Déclarer `site_domain`
# dans l'inventaire déclenchera le certificat automatiquement — mais seulement
# une fois le DNS pointé sur cette machine, sinon Let's Encrypt refuse et
# finit par limiter les tentatives.
:80 {
{% endif %}
	root * {{ site_root }}
	encode zstd gzip
	file_server

	# Les pages sont générées avec un slug par dossier : /article/ → index.html.
	try_files {path} {path}/ {path}/index.html

	handle_errors {
		rewrite * /404.html
		file_server
	}

	header {
		# Le site est entièrement statique : rien à exécuter, rien à injecter.
		Content-Security-Policy "default-src 'none'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Les fichiers portent leur nom de version dans l'URL ; la feuille de style,
	# non : on la garde courte pour pouvoir la changer sans purger un cache.
	@assets path *.css *.woff2
	header @assets Cache-Control "public, max-age=3600"

	# Pas de journal fichier : sous systemd, Caddy écrit dans le journal, qui
	# tourne et se purge tout seul. Un fichier de log, c'est un dossier à créer,
	# des droits à accorder et une rotation à configurer — pour un site statique,
	# `journalctl -u caddy` suffit.
}
