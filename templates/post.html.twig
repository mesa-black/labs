{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} — {{ site.name }}{% endblock %}
{% block description %}{{ post.standfirst ?: site.tagline }}{% endblock %}

{% block main %}
    <main class="wrap">
        <article>
            <header class="post-header">
                <p class="post-meta">
                    <time datetime="{{ post.date|date('Y-m-d') }}">{{ post.date|date_fr }}</time>
                    <span aria-hidden="true">·</span>
                    <span>{{ post.minutes }} min de lecture</span>
                    {% if post.draft %}<span class="draft">brouillon</span>{% endif %}
                </p>
                <h1>{{ post.title }}</h1>
                {% if post.standfirst %}<p class="standfirst">{{ post.standfirst }}</p>{% endif %}
            </header>

            <div class="prose">{{ post.html|raw }}</div>
        </article>

        <p class="back"><a href="/">← Tous les articles</a></p>
    </main>
{% endblock %}
