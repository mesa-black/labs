{% extends 'base.html.twig' %}

{% set siblings = translations[post.key]|default({}) %}

{% block title %}{{ post.title }} — {{ site.name }}{% endblock %}
{% block description %}{{ post.standfirst ?: t.tagline }}{% endblock %}

{# A pointer names the case study as the source; a full piece is authoritative here. #}
{% block canonical %}<link rel="canonical" href="{{ post.canonical ?: site.url ~ post.url }}">{% endblock %}

{% block og_type %}article{% endblock %}
{% block og_title %}{{ post.title }}{% endblock %}
{% block og_description %}{{ post.standfirst ?: t.tagline }}{% endblock %}

{% block schema %}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        'headline': post.title,
        'description': post.standfirst,
        'datePublished': post.date|date('c'),
        'inLanguage': locale,
        'url': site.url ~ post.url,
        'mainEntityOfPage': post.canonical ?: site.url ~ post.url,
        'author': { '@type': 'Organization', 'name': 'BlackMesa' },
        'publisher': { '@type': 'Organization', 'name': 'BlackMesa' },
        'wordCount': post.words,
        'isAccessibleForFree': true
    }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}

{% block alternates %}
    {% for loc, url in siblings %}
    <link rel="alternate" hreflang="{{ loc }}" href="{{ site.url }}{{ url }}">
    {% endfor %}
    {% if siblings['fr'] is defined %}<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ siblings['fr'] }}">{% endif %}
{% endblock %}

{# On an article, the switcher jumps to the same piece rather than the home page. #}
{% block langswitch %}
    {% for loc in locales %}
        {% if siblings[loc] is defined %}
            <a class="lang{{ loc == locale ? ' is-current' : '' }}" hreflang="{{ loc }}"
               href="{{ siblings[loc] }}" {{ loc == locale ? 'aria-current="true"' : '' }}>{{ loc|upper }}</a>
        {% else %}
            <span class="lang is-missing" title="{{ loc|upper }}">{{ loc|upper }}</span>
        {% endif %}
    {% endfor %}
{% endblock %}

{% block main %}
    <main class="wrap">
        <article>
            <header class="post-header">
                <p class="post-meta">
                    <time datetime="{{ post.date|date('Y-m-d') }}">{{ post.date|long_date(locale) }}</time>
                    <span aria-hidden="true">·</span>
                    <span>{{ post.minutes }} {{ t.reading }}</span>
                    {% if post.draft %}<span class="draft">{{ t.draft }}</span>{% endif %}
                </p>
                <h1>{{ post.title }}</h1>
                {% if post.standfirst %}<p class="standfirst">{{ post.standfirst }}</p>{% endif %}
            </header>

            <div class="prose">{{ post.html|raw }}</div>

            {% if post.rex %}
                <aside class="crossover">
                    <p class="crossover-label">{{ post.pointer ? t.crossover_pointer : t.crossover_also }}</p>
                    <a class="crossover-link" href="{{ post.rex }}" target="_blank" rel="noopener">
                        {{ post.pointer ? t.crossover_read : t.crossover_see }} <span aria-hidden="true">→</span>
                    </a>
                    <p class="crossover-note">{{ t.crossover_note }}</p>
                </aside>
            {% endif %}
        </article>

        {# The subject is pre-filled with the title: a reply about one piece
           should arrive saying which, without the reader having to. Absent
           entirely while no mailbox exists — an address that bounces is worse
           than no address. #}
        {% if site.reply %}
            <p class="reply">{{ t.reply }}
                <a href="mailto:{{ site.reply }}?subject={{ post.title|url_encode }}">{{ site.reply }}</a></p>
        {% endif %}

        <p class="back"><a href="{{ home }}">← {{ t.back }}</a></p>
    </main>
{% endblock %}
