{% extends 'base.html.twig' %}

{% block og_title %}{{ site.name }}{% endblock %}

{% block alternates %}
    {% for loc, url in homes %}
    <link rel="alternate" hreflang="{{ loc }}" href="{{ site.url }}{{ url }}">
    {% endfor %}
    {% if homes['fr'] is defined %}<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ homes['fr'] }}">{% endif %}
{% endblock %}

{% block schema %}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'Blog',
        'name': site.name,
        'description': t.tagline,
        'url': site.url ~ page_url,
        'inLanguage': locale,
        'publisher': { '@type': 'Organization', 'name': 'BlackMesa', 'url': 'https://showmetherex.com' }
    }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}

{% block main %}
    <main class="wrap">
        <h1 class="tagline">{{ t.tagline }}</h1>

        <ol class="posts">
            {% for post in posts %}
                <li class="post-item">
                    <a class="post-link" href="{{ post.url }}">
                        <p class="post-meta">
                            <time datetime="{{ post.date|date('Y-m-d') }}">{{ post.date|long_date(locale) }}</time>
                            <span aria-hidden="true">·</span>
                            <span>{{ post.minutes }} {{ t.minutes }}</span>
                            {% if post.draft %}<span class="draft">{{ t.draft }}</span>{% endif %}
                            {% if post.pointer %}<span class="elsewhere">{{ t.elsewhere }}</span>{% endif %}
                        </p>
                        <h2 class="post-title">{{ post.title }}</h2>
                        {% if post.standfirst %}<p class="post-standfirst">{{ post.standfirst }}</p>{% endif %}
                    </a>
                </li>
            {% endfor %}
        </ol>
    </main>
{% endblock %}
