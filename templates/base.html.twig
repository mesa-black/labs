<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site.name }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ t.tagline }}{% endblock %}">
    {% block canonical %}<link rel="canonical" href="{{ site.url }}{{ page_url }}">{% endblock %}
    {% block alternates %}{% endblock %}

    {# Sharing: without this, a link pasted on LinkedIn comes out bare. #}
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="{{ locale }}">
    <meta property="og:url" content="{{ site.url }}{{ page_url }}">
    <meta property="og:title" content="{% block og_title %}{{ site.name }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ t.tagline }}{% endblock %}">
    {# A card with a title on it, or nothing: an empty thumbnail is worse than a
       bare link, and a house card repeated on every piece says nothing. #}
    {% if og_image is defined %}
        <meta property="og:image" content="{{ site.url }}{{ og_image }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta name="twitter:card" content="summary_large_image">
    {% else %}
        <meta name="twitter:card" content="summary">
    {% endif %}

    {% block author %}{% endblock %}
    {% block schema %}{% endblock %}
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ site.url }}{{ feed_url }}">
    {# The two faces every page opens with, asked for before the stylesheet names them. #}
    <link rel="preload" href="/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/archivo-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ style_url }}">
</head>
<body>
    <header class="masthead">
        <div class="wrap masthead-in">
            {# A crowbar beside the name: the house is called after a research
               facility where one came in handy. Drawn here, like the mesa in
               the footer; neither is anybody else's picture. #}
            <a class="wordmark" href="{{ home }}"><svg class="crowbar" viewBox="0 0 24.7 18.5" aria-hidden="true"
                fill="currentColor" stroke="currentColor" stroke-width=".6" stroke-linejoin="round"><path d="M1.96 16.53 L4.29 17.65 L6.99 18.06 L12.09 15.14 L16.95 12.33 L21.99 9.42 L23.18 8.44 L24.02 7.11 L24.39 5.58 L24.26 4.01 L23.64 2.57 L22.59 1.39 L21.17 0.75 L19.67 0.60 L18.24 0.93 L17.10 1.63 L16.00 2.81 L15.01 4.01 L15.41 4.58 L16.88 4.06 L18.24 3.52 L18.95 3.33 L19.57 3.40 L20.08 3.65 L20.45 4.03 L20.77 4.39 L20.96 4.84 L21.00 5.32 L20.89 5.78 L20.63 6.19 L20.22 6.52 L15.25 9.39 L10.39 12.19 L5.77 14.88 L4.53 14.94 L2.04 15.64Z"/></svg>{{ site.name }}</a>
            <nav class="masthead-nav" aria-label="{{ t.language }}">
                {% block langswitch %}
                    {% for loc in locales %}
                        <a class="lang{{ loc == locale ? ' is-current' : '' }}" hreflang="{{ loc }}"
                           href="{{ loc == 'fr' ? '/' : '/' ~ loc ~ '/' }}"
                           {{ loc == locale ? 'aria-current="true"' : '' }}>{{ loc|upper }}</a>
                    {% endfor %}
                {% endblock %}
                <a class="feed" href="{{ feed_url }}">{{ t.feed }}</a>
                {# Same cluster as the feed: both are artefacts for a machine
                   rather than pages to read, and the monospace says so. #}
                {% if audit_published %}<a class="feed" href="{{ audit_url }}"
                    target="_blank" rel="noopener" title="{{ t.footer_audit }}">{{ t.nav_audit }}</a>{% endif %}
            </nav>
        </div>
    </header>

    {% block main %}{% endblock %}

    <footer class="site-footer">
        <div class="wrap">
            {# The mesa stands on the rule of the footer, which is its ground. #}
            <svg class="mesa" viewBox="0 0 400 60" aria-hidden="true" fill="none" stroke="currentColor"
                stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 60 L52 45 L70 44 L82 19 L96 15 H232 L244 20 L254 44 L276 47 L300 60"/>
                <path d="M88 28 H249 M79 36 H252" opacity=".5"/>
                <path d="M318 60 L330 41 L336 38 H360 L365 42 L376 60"/>
                <g class="mesa-stars" fill="currentColor" stroke="none"><circle cx="40" cy="22" r="1.1"/><circle cx="290" cy="13" r="1.3"/><circle cx="346" cy="7" r=".9"/><circle cx="388" cy="26" r="1"/></g>
            </svg>
            <p>{{ t.tagline }}</p>
            <p>{{ t.footer_agency }}</p>
            {# Both leave the blog: the platform, and a self-contained document. #}
            <p>{{ t.footer_smtr }} <a href="{{ smtr_url }}" target="_blank" rel="noopener">Show me the REX</a>.</p>
            {# French only: the other languages say so in the link itself. #}
            <p>{{ t.footer_observatoire }} <a href="https://observatoire.mesa.black/" target="_blank" rel="noopener"{{ locale != 'fr' ? ' hreflang="fr"' : '' }}>{{ t.footer_observatoire_link }}</a>.</p>
            {% if audit_published %}<p>{{ t.footer_audit }} :
                <a href="{{ audit_url }}" target="_blank" rel="noopener">{{ t.footer_audit_hint }}</a>.</p>{% endif %}
        </div>
    </footer>
</body>
</html>
