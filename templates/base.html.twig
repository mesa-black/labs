<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site.name }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ t.tagline }}{% endblock %}">
    {% block canonical %}<link rel="canonical" href="{{ site.url }}{{ page_url }}">{% endblock %}
    {% block alternates %}{% endblock %}

    {# Sharing: without this, a link pasted on LinkedIn comes out bare. #}
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="{{ locale }}">
    <meta property="og:url" content="{{ site.url }}{{ page_url }}">
    <meta property="og:title" content="{% block og_title %}{{ site.name }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ t.tagline }}{% endblock %}">
    {# A card with a title on it, or nothing: an empty thumbnail is worse than a
       bare link, and a house card repeated on every piece says nothing. #}
    {% if og_image is defined %}
        <meta property="og:image" content="{{ site.url }}{{ og_image }}">
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta name="twitter:card" content="summary_large_image">
    {% else %}
        <meta name="twitter:card" content="summary">
    {% endif %}

    {% block author %}{% endblock %}
    {% block schema %}{% endblock %}
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ site.url }}{{ feed_url }}">
    {# The two faces every page opens with, asked for before the stylesheet names them. #}
    <link rel="preload" href="/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/archivo-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ style_url }}">
</head>
<body>
    <header class="masthead">
        <div class="wrap masthead-in">
            <a class="wordmark" href="{{ home }}">{{ site.name }}</a>
            <nav class="masthead-nav" aria-label="{{ t.language }}">
                {% block langswitch %}
                    {% for loc in locales %}
                        <a class="lang{{ loc == locale ? ' is-current' : '' }}" hreflang="{{ loc }}"
                           href="{{ loc == 'fr' ? '/' : '/' ~ loc ~ '/' }}"
                           {{ loc == locale ? 'aria-current="true"' : '' }}>{{ loc|upper }}</a>
                    {% endfor %}
                {% endblock %}
                <a class="feed" href="{{ feed_url }}">{{ t.feed }}</a>
                {# Same cluster as the feed: both are artefacts for a machine
                   rather than pages to read, and the monospace says so. #}
                {% if audit_published %}<a class="feed" href="{{ audit_url }}"
                    target="_blank" rel="noopener" title="{{ t.footer_audit }}">{{ t.nav_audit }}</a>{% endif %}
            </nav>
        </div>
    </header>

    {% block main %}{% endblock %}

    <footer class="site-footer">
        <div class="wrap">
            <p>{{ t.tagline }}</p>
            <p>{{ t.footer_agency }}</p>
            {# Both leave the blog: the platform, and a self-contained document. #}
            <p>{{ t.footer_smtr }} <a href="{{ smtr_url }}" target="_blank" rel="noopener">Show me the REX</a>.</p>
            {% if audit_published %}<p>{{ t.footer_audit }} :
                <a href="{{ audit_url }}" target="_blank" rel="noopener">{{ t.footer_audit_hint }}</a>.</p>{% endif %}
        </div>
    </footer>
</body>
</html>
