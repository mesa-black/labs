<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ site.name }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ t.tagline }}{% endblock %}">
    {% block canonical %}<link rel="canonical" href="{{ site.url }}{{ page_url }}">{% endblock %}
    {% block alternates %}{% endblock %}

    {# Sharing: without this, a link pasted on LinkedIn comes out bare. #}
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:locale" content="{{ locale }}">
    <meta property="og:url" content="{{ site.url }}{{ page_url }}">
    <meta property="og:title" content="{% block og_title %}{{ site.name }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ t.tagline }}{% endblock %}">
    <meta name="twitter:card" content="summary">

    {% block schema %}{% endblock %}
    <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ site.url }}{{ feed_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="masthead">
        <div class="wrap masthead-in">
            <a class="wordmark" href="{{ home }}">{{ site.name }}</a>
            <nav class="masthead-nav" aria-label="{{ t.language }}">
                {% block langswitch %}
                    {% for loc in locales %}
                        <a class="lang{{ loc == locale ? ' is-current' : '' }}" hreflang="{{ loc }}"
                           href="{{ loc == 'fr' ? '/' : '/' ~ loc ~ '/' }}"
                           {{ loc == locale ? 'aria-current="true"' : '' }}>{{ loc|upper }}</a>
                    {% endfor %}
                {% endblock %}
                <a class="feed" href="{{ feed_url }}">{{ t.feed }}</a>
            </nav>
        </div>
    </header>

    {% block main %}{% endblock %}

    <footer class="site-footer">
        <div class="wrap">
            <p>{{ t.tagline }}</p>
            <p>{{ t.footer_agency }}</p>
            {# Both leave the blog: the platform, and a self-contained document. #}
            <p>{{ t.footer_smtr }} <a href="{{ smtr_url }}" target="_blank" rel="noopener">Show me the REX</a>.</p>
            {% if audit_published %}<p>{{ t.footer_audit }} :
                <a href="/audit/report.html" target="_blank" rel="noopener">{{ t.footer_audit_hint }}</a>.</p>{% endif %}
        </div>
    </footer>
</body>
</html>
