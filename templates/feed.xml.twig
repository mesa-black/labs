<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ locale }}">
    <title>{{ site.name }}</title>
    <subtitle>{{ t.tagline }}</subtitle>
    <link href="{{ site.url }}{{ feed_url }}" rel="self"/>
    <link href="{{ site.url }}{{ home }}"/>
    <updated>{{ posts|first.date|date('c') }}</updated>
    <id>{{ site.url }}{{ home }}</id>
    {% for post in posts %}
    <entry>
        <title>{{ post.title }}</title>
        <link href="{{ site.url }}{{ post.url }}"/>
        <id>{{ site.url }}{{ post.url }}</id>
        <updated>{{ post.date|date('c') }}</updated>
        {% if post.standfirst %}<summary>{{ post.standfirst }}</summary>{% endif %}
        <content type="html">{{ post.html }}</content>
    </entry>
    {% endfor %}
</feed>
