<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>{{ site.name }}</title>
    <subtitle>{{ site.tagline }}</subtitle>
    <link href="{{ site.url }}/feed.xml" rel="self"/>
    <link href="{{ site.url }}/"/>
    <updated>{{ posts|first.date|date('c') }}</updated>
    <id>{{ site.url }}/</id>
    {% for post in posts %}
    <entry>
        <title>{{ post.title }}</title>
        <link href="{{ site.url }}/{{ post.slug }}/"/>
        <id>{{ site.url }}/{{ post.slug }}/</id>
        <updated>{{ post.date|date('c') }}</updated>
        {% if post.standfirst %}<summary>{{ post.standfirst }}</summary>{% endif %}
        <content type="html">{{ post.html }}</content>
    </entry>
    {% endfor %}
</feed>
